{
  "name": "dsh-novel-beat",
  "version": "0.7.0",
  "description": "AI 写小说，关键剧情由你拍板：一次只问一个岔路，写一段、登记一段，拍板写进全书账本；整章闷头写完会被拦，写错可级联回退。默认关闭，不写正文，不依赖其他插件。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./remote": "./lib/remote.js",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "docs/adapter-contract.md",
    "docs/conductor-adapter.md",
    "docs/tools.md",
    "docs/architecture.md",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "novel-writing",
    "ai-writing",
    "plot",
    "worldbuilding",
    "workflow"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "contributors": [
    {
      "name": "MiyueWinter",
      "email": "mingyue_11129@qq.com",
      "url": "https://github.com/MiyueWinter"
    }
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrizzleGig/dsh-novel-beat.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-beat",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-beat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
