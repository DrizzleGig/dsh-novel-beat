{
  "name": "dsh-novel-beat",
  "version": "0.9.2",
  "description": "AI 写小说，关键剧情由你拍板。右栏「拍板台」按章看全书决策：改选前先看会删多少字、作废几段、撤回哪些设定、重开哪些决策，确认后安全回退，旧正文留档可查。默认关闭，不写正文。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./remote": "./lib/remote.js",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check lib/remote.js && node --check lib/remote-contract.js && node --check lib/panel.js && node --check lib/rewind.js && node --check lib/resume.js && node --check lib/tool-schema.mjs",
    "check:panel": "node scripts/check-panel.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "docs/adapter-contract.md",
    "docs/contract.md",
    "docs/conductor-adapter.md",
    "docs/tools.md",
    "docs/architecture.md",
    "docs/v0.8.0-implementation.md",
    "cordis.patch.yml",
    "icon.svg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "novel-writing",
    "ai-writing",
    "plot",
    "worldbuilding",
    "workflow"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "contributors": [
    {
      "name": "MiyueWinter",
      "email": "mingyue_11129@qq.com",
      "url": "https://github.com/MiyueWinter"
    }
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrizzleGig/dsh-novel-beat.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-beat",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-beat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
