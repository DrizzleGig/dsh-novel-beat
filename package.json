{
  "name": "dsh-novel-beat",
  "version": "0.6.0",
  "description": "让 AI 继续写，但关键剧情由你决定。AI 写到会改变故事走向的岔路时暂停，给你 2–4 个走向及其代价；拍板写进全书账本，下一章接着用，写完再做结构核对。默认关闭，不写正文，不依赖其他插件。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./remote": "./lib/remote.js",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "novel-writing",
    "ai-writing",
    "plot",
    "worldbuilding",
    "workflow"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrizzleGig/dsh-novel-beat.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-beat",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-beat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
