{
  "name": "dsh-novel-beat",
  "version": "0.5.0",
  "description": "决策点问询：每遇到一个会改变剧情走向的节点就交给作者拍板（含信息揭露程度），数量由实际节点密度决定、无上下限；空白书从一句创意开始就能用，边推演边拦截；每个选项写清选了会发生什么，拍板结果落账并编译成细纲。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "plot",
    "workflow"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrizzleGig/dsh-novel-beat.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-beat",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-beat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
