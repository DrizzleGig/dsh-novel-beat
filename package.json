{
  "name": "dsh-novel-beat",
  "version": "0.6.0",
  "description": "每一处关键，都由你拍板。正文之前拦下会改变剧情走向的节点，每个给你 2–4 个真分叉；拍板写进全书账本，下一章记得，写完还能验。更好的创作，不依赖其他插件。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./remote": "./lib/remote.js",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "novel-writing",
    "ai-writing",
    "plot",
    "worldbuilding",
    "workflow"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrizzleGig/dsh-novel-beat.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-beat",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-beat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
